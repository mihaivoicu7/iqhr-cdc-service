<configuration>
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>%level %logger{36} - %msg%n</pattern></encoder></appender>
  <logger name="org.apache.activemq.audit" level="OFF"/>
  <logger name="org.hibernate" level="ERROR"/>
  <root level="WARN"><appender-ref ref="console"/></root>
</configuration>
